<div class="pf-profile-container">

  <header class="pf-profile-header">

    <div class="pf-profile-pic">
      <div class="pf-avatar">
        <%= @user.email.first.upcase %>
      </div>
    </div>

    <div class="pf-profile-info">

      <div class="pf-profile-title-row">
        <h1 class="pf-username"><%= @user.email.split('@').first %></h1>

        <div class="pf-profile-actions">
          <% if current_user == @user %>
            <%= link_to "Edit profile", edit_user_registration_path, class: "btn-edit-profile" %>
          <% else %>
            <% if current_user.following.include?(@user) %>
              <%= button_to "Unfollow", follow_path(id: current_user.following_relationships.find_by(followed: @user).id), method: :delete, class: "pf-btn pf-btn-secondary" %>
            <% else %>
              <%= button_to "Follow", follows_path(followed_id: @user.id), method: :post, class: "pf-btn pf-btn-primary" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <ul class="pf-profile-stats">
        <li><span class="pf-stat-count"><%= @user.posts.count %></span> posts</li>
        <li><span class="pf-stat-count"><%= @user.followers.count %></span> followers</li>
        <li><span class="pf-stat-count"><%= @user.following.count %></span> following</li>
      </ul>

      <div class="pf-profile-bio">
        <p class="pf-full-name"><%= @user.email %></p>
        <p>My BookShelf! Wait for the bio.</p>
      </div>

    </div>
  </header>

  <div class="bookshelf-feed-column" style="margin-top: 2rem;">

    <div class="feed-header">
      <h2>Posts</h2>
    </div>

    <div class="feed-posts">
      <% if @user.posts.present? %>

        <!-- Render the collection, keeping the newest-first order -->
        <%= render @user.posts.order(created_at: :desc) %>

      <% else %>
        <div class="empty-feed">
          <p>No posts yet.</p>
        </div>
      <% end %>
    </div>

  </div>

</div>