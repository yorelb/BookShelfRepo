<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>User Directory</h1>
</div>


  <% @users.each do |user| %>
    <div class="user_index_card">
      <span class="user-email">
        <%= link_to user.email, user_path(user) %>
      </span>

      <div class="unfollow_follow_button">
        <% if current_user.following.include?(user) %>
          <%= button_to "Unfollow", follow_path(id: current_user.following_relationships.find_by(followed: user).id), method: :delete, class: "btn-unfollow" %>
        <% else %>
          <%= button_to "Follow", follows_path(followed_id: user.id), method: :post, class: "btn-follow" %>
        <% end %>
      </div>
    </div>
  <% end %>
