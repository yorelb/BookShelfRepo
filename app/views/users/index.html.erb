<div class="bookshelf-layout-container">

  <main class="bookshelf-feed-column">

    <%= render "posts/compose" %>

    <div class="feed-posts">
      <% if @posts.present? %>
        <% @posts.each do |post| %>
          <%= render @posts %>
        <% end %>
      <% else %>
        <div class="empty-feed">
          <p>No posts yet. Be the first to say something!</p>
        </div>
      <% end %>
    </div>
  </main>

  <aside class="bookshelf-sidebar">

    <div class="sidebar-search-container">
      <%= form_with url: users_path, method: :get, local: true, class: "bookshelf-search-form" do |f| %>
        <div class="search-input-wrapper">
          <span class="search-icon">🔍</span>
          <%= f.text_field :query, placeholder: "Search", class: "bookshelf-search-input" %>
        </div>
      <% end %>
    </div>

    <div class="who-to-follow-box">
      <h3>Who to follow</h3>

      <div class="suggestions-list">
        <% @users.each do |user| %>
          <% next if user == current_user %>

          <div class="suggestion-item">
            <div class="suggestion-user-info">
              <div class="suggestion-avatar"><%= user.email.first.upcase %></div>
              <%= link_to user.email.split('@').first, user_path(user), class: "suggestion-username" %>
            </div>

            <div class="suggestion-action">
                <%= button_to "Follow", follows_path(followed_id: user.id), method: :post, class: "btn-follow btn-small" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </aside>

</div>