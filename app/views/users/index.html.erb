<h1>User Directory</h1>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= user.email %>

      <% if current_user.following.include?(user) %>
        <%= button_to "Unfollow", follow_path(id: current_user.following_relationships.find_by(followed: user).id), method: :delete %>
      <% else %>
        <%= button_to "Follow", follows_path(followed_id: user.id), method: :post %>
      <% end %>
    </li>
  <% end %>
</ul>
