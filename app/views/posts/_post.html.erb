<div class="post-card">
  <div class="post-avatar">
    <%= post.user.email.first.upcase %>
  </div>
  <div class="post-content">

    <div class="post-header-row">
      <div class="post-header-info">
        <%= link_to post.user.email.split('@').first, user_path(post.user), class: "post-username" %>
        <span class="post-time">· <%= time_ago_in_words(post.created_at) %> ago</span>
      </div>

      <% if post.user == current_user %>
        <%= button_to "Delete", post_path(post), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete this post?" } }, class: "btn-delete-post" %>
      <% end %>
    </div>

    <p class="post-body"><%= post.body %></p>
  </div>
</div>